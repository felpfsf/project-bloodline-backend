{
  "AllowedHosts": "*",
  "Jwt": {
    "Issuer": "Bloodline.Api",
    "Audience": "Bloodline.Mobile",
    "AccessTokenExpirationMinutes": 30
  },
  "ConnectionStrings": {
    "PostgreSql": "Host=localhost;Port=5432;Database=bloodline;Username=bloodline;Password=bloodline_dev"
  },
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console",
      "Serilog.Sinks.Seq"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Information",
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Information"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "Seq",
        "Args": {
          "serverUrl": "http://localhost:5341"
        }
      }
    ],
    "Enrich": [
      "FromLogContext"
    ],
    "Properties": {
      "Environment": "Development"
    }
  }
}